{
  "name": "@hsaohuang/crucible",
  "version": "0.1.1",
  "description": "Find AI-generated tests that assert nothing, then rewrite them until they actually catch bugs.",
  "type": "module",
  "bin": {
    "crucible": "bin/crucible.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 'test/*.test.js'",
    "selftest": "node bin/crucible.js scan test/fixtures/project --json"
  },
  "keywords": [
    "testing",
    "mutation-testing",
    "ai-generated-code",
    "test-quality",
    "claude-code",
    "opencode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoshuhang/crucible.git"
  },
  "homepage": "https://github.com/aoshuhang/crucible#readme",
  "bugs": {
    "url": "https://github.com/aoshuhang/crucible/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
