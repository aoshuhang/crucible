{
  "name": "unfake",
  "version": "0.1.0",
  "description": "Find AI-generated tests that assert nothing, then rewrite them until they actually catch bugs.",
  "type": "module",
  "bin": {
    "unfake": "./bin/unfake.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 'test/*.test.js'",
    "selftest": "node bin/unfake.js scan test/fixtures/project --json"
  },
  "keywords": [
    "testing",
    "mutation-testing",
    "ai-generated-code",
    "test-quality",
    "claude-code",
    "opencode"
  ],
  "license": "MIT"
}
